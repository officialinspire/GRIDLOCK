{
  "name": "grid-lock-city",
  "version": "1.4.1",
  "private": true,
  "description": "Grid Lock City \u2014 papercraft tabletop city-building game (vanilla HTML/CSS/JS).",
  "type": "module",
  "scripts": {
    "start": "node tests/serve.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:smoke:chromium": "BROWSER=chromium node tests/smoke.mjs",
    "test:smoke:webkit": "BROWSER=webkit node tests/smoke.mjs",
    "test:smoke:firefox": "BROWSER=firefox node tests/smoke.mjs",
    "test:pwa": "node tests/pwa.mjs",
    "simulate": "node tools/simulate.mjs",
    "simulate:cpu": "node tools/cpu-simulate.mjs",
    "balance": "node tools/balance.mjs",
    "build:assets": "node tools/build-assets.mjs",
    "build:pwa": "node tools/build-pwa.mjs",
    "build:icons": "node tools/build-pwa.mjs --icons"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
